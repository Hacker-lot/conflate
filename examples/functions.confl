@python
def twice(n):
    return n * 2

@cpp
int next_count(int increment) {
    static int count = 0;
    count += increment;
    return count;
}
int call_python(int n) {
    return twice(n).as<int>();
}

@python
assert next_count(1) == 1
assert call_python(21) == 42

@cpp
std::cout << next_count(1) << "\n";

@python
assert next_count(1) == 3
print("The function kept its state across three calls.")
